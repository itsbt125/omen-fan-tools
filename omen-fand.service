[Unit]
Description=HP Omen Fan Curve Daemon
After=systemd-modules-load.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# ExecCondition runs BEFORE ExecStartPre, so the modprobe must live inside
# the condition itself or the check always fails on a fresh boot. Keeps boot
# clean if the custom module is missing for this kernel.
ExecCondition=/bin/sh -c '/sbin/modprobe hp_wmi_fan_ctrl 2>/dev/null; test -e /sys/module/hp_wmi_fan_ctrl/fans'
ExecStart=/usr/local/bin/omen-fand --verbose
ExecStopPost=/bin/sh -c 'echo auto > /sys/module/hp_wmi_fan_ctrl/fans 2>/dev/null || true'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
